{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faf.one/schemas/fafm.schema.json",
  "title": "FAF Memory (.fafm)",
  "description": "Schema for application/vnd.fafm+yaml v1.2. One format, profiles (voice|knowledge). Unknown fields are permitted and MUST be ignored by consumers (additionalProperties: true throughout); writers MUST preserve them. Date-times are RFC 3339 strings.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "namepoint", "created", "last_etched", "memory"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+$",
      "description": "Semantic version of the document format, e.g. \"1.2\". Readers accept a higher minor of the same major."
    },
    "profile": {
      "type": "string",
      "enum": ["voice", "knowledge"],
      "default": "voice",
      "description": "Use-case shape. Absent => voice (v1.0 back-compat). Unknown values are invalid."
    },
    "namepoint": {
      "type": "string",
      "description": "Soul identifier. Voice uses @handle; other profiles MAY namespace, e.g. @claude-code:wolfejam."
    },
    "created": { "type": "string", "format": "date-time" },
    "last_etched": { "type": "string", "format": "date-time" },
    "retention": {
      "type": "string",
      "description": "forever (default) | 30d | 90d | 1y | session-only (or implementation-defined)."
    },
    "index": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional one-line pointers (knowledge profile)."
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "facts": {
          "type": "array",
          "description": "Memory units. May mix bare strings, {text,tags?} objects, and rich objects in the same array.",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/fact" }
            ]
          }
        },
        "sessions": { "type": "array" },
        "preferences": { "type": "object", "additionalProperties": true },
        "custom": { "type": "object", "additionalProperties": true },
        "tombstones": {
          "type": "array",
          "description": "Optional (v1.2): deletes recorded for sync/merge. Each entry has id or txt_hash (id wins if both), plus deleted_at in UTC (Z). Never holds the forgotten text or say.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["deleted_at"],
            "anyOf": [
              { "required": ["id"], "properties": { "id": { "type": "string" } } },
              { "required": ["txt_hash"], "properties": { "txt_hash": { "type": "string" } } }
            ],
            "not": {
              "anyOf": [
                { "required": ["text"], "properties": { "text": true } },
                { "required": ["say"], "properties": { "say": true } }
              ]
            },
            "properties": {
              "id": { "type": "string" },
              "txt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "deleted_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "description": "REQUIRED. The memory unit any consumer can read." },
        "say": { "type": "string", "description": "Optional (v1.2): the spoken form of text, as a plain-text respelling. Never spoken as content." },
        "tags": { "type": "array", "items": { "type": "string" } },
        "id": { "type": "string", "description": "Stable unique key (knowledge)." },
        "type": {
          "type": "string",
          "examples": ["user", "feedback", "project", "reference"],
          "description": "Canonical knowledge types: user | feedback | project | reference. Other values are valid and treated as unclassified (v1.2). Domain distinctions use tags/custom, not enum expansion."
        },
        "priority": {
          "type": "string",
          "examples": ["ephemeral", "standard", "high", "critical"],
          "description": "Canonical priority vocabulary: ephemeral | standard | high | critical. Other values are valid and treated as standard (v1.2)."
        },
        "links": { "type": "array", "items": { "type": "string" }, "description": "Cross-references to other entry ids." },
        "timestamp": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "version_id": { "type": "string", "description": "Reserved: entry revision / etag." },
        "provenance": { "type": "array", "description": "Reserved: lightweight chain / parent refs." },
        "parent_id": { "type": "string", "description": "Reserved: merge lineage." },
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "etched_by": { "type": "string", "description": "Reserved: human | ai | agent_id." },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "verification_status": {
          "type": "string",
          "enum": ["unverified", "verified", "disputed"]
        },
        "ttl": { "type": "string", "description": "Reserved: per-entry forgetting duration." },
        "decay_policy": { "type": "string", "description": "Reserved: named decay policy." },
        "conflict_metadata": { "type": "object", "additionalProperties": true },
        "embedding_fingerprint": { "type": "string", "description": "Reserved: semantic dedup hash." },
        "signature": { "type": "string", "description": "Reserved: optional light provenance (merkle/sig)." }
      }
    }
  }
}
